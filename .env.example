NEXT_PUBLIC_SITE_URL=http://localhost:3212

# Рекламная сеть Яндекса. Идентификаторы блоков выдаёт кабинет РСЯ
# (Продукты → блок → Получить код), придумать их нельзя. Пока переменные пусты,
# реклама выключена целиком: загрузчик не подключается, CSP не ослабляется.
# Значения подставляются на сборке, поэтому после их изменения нужен ребилд.
NEXT_PUBLIC_YANDEX_RTB_CALCULATOR_TOP=
NEXT_PUBLIC_YANDEX_RTB_CALCULATOR_BOTTOM=

# Содержимое /ads.txt: кабинет РСЯ, Настройки → Общие → ads.txt.
# Несколько строк записываются через \n внутри двойных кавычек.
# Пока пусто — /ads.txt отвечает 404.
YANDEX_ADS_TXT=
