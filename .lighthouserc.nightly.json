{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://127.0.0.1:3212/",
        "http://127.0.0.1:3212/kalkulyator/procent-ot-chisla"
      ],
      "numberOfRuns": 5,
      "settings": {
        "chromeFlags": "--headless --no-sandbox",
        "skipAudits": ["third-party-cookies", "inspector-issues"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:3212/$",
          "assertions": {
            "categories:performance": [
              "error",
              { "minScore": 0.9, "aggregationMethod": "median" }
            ],
            "categories:accessibility": [
              "error",
              { "minScore": 0.95, "aggregationMethod": "median" }
            ],
            "categories:best-practices": [
              "error",
              { "minScore": 0.95, "aggregationMethod": "median" }
            ],
            "categories:seo": [
              "error",
              { "minScore": 0.95, "aggregationMethod": "median" }
            ],
            "largest-contentful-paint": [
              "error",
              { "maxNumericValue": 2500, "aggregationMethod": "median" }
            ],
            "cumulative-layout-shift": [
              "error",
              { "maxNumericValue": 0.1, "aggregationMethod": "median" }
            ],
            "total-blocking-time": [
              "error",
              { "maxNumericValue": 300, "aggregationMethod": "median" }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:3212/kalkulyator/.*",
          "assertions": {
            "categories:performance": [
              "error",
              { "minScore": 0.9, "aggregationMethod": "median" }
            ],
            "categories:accessibility": [
              "error",
              { "minScore": 0.95, "aggregationMethod": "median" }
            ],
            "categories:best-practices": [
              "error",
              { "minScore": 0.95, "aggregationMethod": "median" }
            ],
            "categories:seo": [
              "error",
              { "minScore": 0.95, "aggregationMethod": "median" }
            ],
            "largest-contentful-paint": [
              "error",
              { "maxNumericValue": 2500, "aggregationMethod": "median" }
            ],
            "cumulative-layout-shift": [
              "error",
              { "maxNumericValue": 0.1, "aggregationMethod": "median" }
            ],
            "total-blocking-time": [
              "error",
              { "maxNumericValue": 400, "aggregationMethod": "median" }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./artifacts/lighthouse"
    }
  }
}
